{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "files.associations": {
    "**/templates/**/*.html": "django-html"
  },
  "emmet.includeLanguages": {
    "django-html": "html"
  },
  "files.exclude": {
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/staticfiles": true
  },
  "files.encoding": "utf8",
  "editor.rulers": [130],
  "sqltools.connections": [
    {
      "name": "ExtinPro (local)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5432,
      "database": "extinpro",
      "username": "extinpro",
      "askForPassword": true,
      "previewLimit": 50
    }
  ]
}
