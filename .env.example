# Copia este archivo como .env y ajusta los valores. El .env NUNCA se sube a Git.
# (scripts\preparar_entorno.ps1 lo genera por ti con una SECRET_KEY nueva.)

# Clave secreta de Django: genera una con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esta-clave

# True solo en tu computadora. En un servidor debe ser False.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: postgres://USUARIO:CONTRASEÑA@SERVIDOR:PUERTO/BASE
# (si la contraseña lleva símbolos como @ : / #, escríbelos codificados: @ = %40, # = %23)
DATABASE_URL=postgres://extinpro:CAMBIA_ESTA_CONTRASENA@localhost:5432/extinpro

# Esquema donde viven las tablas (igual que el script del Entregable 6)
DB_SCHEMA=extinpro
